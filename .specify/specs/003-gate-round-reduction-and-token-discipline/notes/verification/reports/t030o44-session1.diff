+    for l in C en_US.UTF-8; do
+      run_rc 3 in_locale "$l" bash "$cli" round "$spec" opponent --complete "$report"
+      assert_contains "$OUT" "${row#*|}" "AC-009: a CLEARED round 2 under ${row%%|*} was not refused under LANG=$l (O-018)"
+    done
