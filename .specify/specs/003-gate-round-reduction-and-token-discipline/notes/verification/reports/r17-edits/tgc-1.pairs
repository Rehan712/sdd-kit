    record_round 1 CHALLENGED 1 0 '### Finding G-050' dup-binding new '- **Severity:** data-loss' |
      sed 's#^- \*\*Where:\*\* scripts/run.sh:9$#- **Where:** a.sh:1<br>b.sh:2 and <p>c.sh:3#' > "$report"
    run_rc 0 record_line_vf "$l" "$report" "$spec"
