+# The frontmatter reads the harness decides with. lib.sh's fm_get treats every
+# failure as "no value", which is right for its other callers and wrong here: a
+# frontmatter parse that failed read as no verification_contract, and no
+# contract selects the legacy path, which downgrades v1 binding errors to
+# warnings, skips checkpoint coverage, ticks a v1 task on --evidence alone and
+# swaps vf_evidence_current for the legacy check; a failed worktree or branch
+# read skipped the gate's mismatch checks. These read the same block fm_get
+# reads (the lines between an opening `---` on line 1 and the next `---`), keep
+# its value rules (first line setting the key; a quoted value up to its closing
+# quote; otherwise an inline ` #` comment and trailing blanks dropped), and fail
+# with status 3 when the parse fails, so no parse failure reads as a passing
+# result (T030o43).
+vf_fm_value() { # <file> <key> -> the value, or nothing when the key is absent
+  [[ -f "$1" ]] || return 0
+  awk -v key="$2" '# vf_fm_value
+    NR == 1 { if ($0 != "---") exit; next }
+    /^---[[:space:]]*$/ { exit }
+    index($0, key ":") == 1 {
+      v = substr($0, length(key) + 2); sub(/^[[:space:]]+/, "", v)
+      q = substr(v, 1, 1)
+      if (q == "\"" || q == "\047") { v = substr(v, 2); sub(q ".*$", "", v) }
+      else { sub(/[[:space:]]+#.*$/, "", v); sub(/[[:space:]]+$/, "", v) }
+      print v; exit
+    }
+  ' "$1" || { printf 'error: %s: frontmatter could not be read for %s\n' "$1" "$2" >&2; return 3; }
+}
+vf_fm_count() { # <file> <key> -> how many frontmatter lines set the key
+  [[ -f "$1" ]] || { echo 0; return 0; }
+  awk -v name="$2" '# vf_fm_count
+    NR == 1 { if ($0 != "---") exit; next }
+    /^---[[:space:]]*$/ { exit }
+    index($0, name ":") == 1 { n++ }
+    END { print n + 0 }
+  ' "$1" || { printf 'error: %s: frontmatter could not be counted for %s\n' "$1" "$2" >&2; return 3; }
+}
