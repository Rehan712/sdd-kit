+# The harness's own parsing runs under the C locale (O-017, round 12). Every
+# grammar the kit parses is ASCII, so C reads every record a UTF-8 or
+# single-byte locale reads, and decodes every byte, where they do not: under a
+# UTF-8 locale macOS awk dies at the first byte it cannot decode, and grep
+# stops matching there and still exits 0. One cp1252 apostrophe in a
+# prior-review manifest dropped the history a clearing verdict is checked
+# against, and a clarification marker after such a byte read as absent. The
+# member is the harness itself: the files vf_snapshot records as `harness`, and
+# every process they start except the command a capture runs. The pin is placed
+# once, here, and every harness entry script loads this library directly after
+# lib.sh, before any program reads a repository or bookkeeping byte; the export
+# reaches each process it starts. lib.sh stays unpinned, so 002's dispatcher,
+# which sources it but not this library, and the provider CLIs it starts keep
+# the user's locale.
+#
+# The caller's LC_ALL (a value, empty, or unset) is kept in the exported
+# SDD_HARNESS_CALLER_LC_ALL, `unset` or `set:<value>`, so a harness process
+# started by another (`accept` execs spec-task.sh; the floor runs
+# `spec-task.sh list`) still knows it. A process takes the record afresh only
+# when it starts with none, or with LC_ALL other than C, which means LC_ALL
+# was set after the harness last pinned it. A caller who exports the record by
+# hand gets exactly what exporting that LC_ALL would give.
+vf_locale_pin() {
+  if [[ -z "${SDD_HARNESS_CALLER_LC_ALL:-}" || "${LC_ALL-}" != C ]]; then
+    if [[ -n "${LC_ALL+set}" ]]; then SDD_HARNESS_CALLER_LC_ALL="set:$LC_ALL"; else SDD_HARNESS_CALLER_LC_ALL='unset'; fi
+    export SDD_HARNESS_CALLER_LC_ALL
+  fi
+  export LC_ALL=C
+}
+# The command a capture runs is the one program the harness starts that is
+# not its own parsing: it gets the caller's LC_ALL back exactly, and not the
+# record. Call this only in the subshell that runs that command.
+vf_caller_locale() {
+  case "${SDD_HARNESS_CALLER_LC_ALL:-}" in
+    unset) unset LC_ALL;;
+    set:*) export LC_ALL="${SDD_HARNESS_CALLER_LC_ALL#set:}";;
+  esac
+  unset SDD_HARNESS_CALLER_LC_ALL
+}
+# vf_caller_env <name> <output>: the caller's value of <name>, written to
+# <output> with status 0; status 1 when the caller has it unset; 3 when the
+# value cannot be written. LC_ALL is the one name the harness changes, so the
+# record of a declared LC_ALL carries the value the caller, and the captured
+# command, has, never the pin's.
+vf_caller_env() {
+  if [[ "$1" == LC_ALL ]]; then
+    case "${SDD_HARNESS_CALLER_LC_ALL:-}" in
+      unset) return 1;;
+      set:*) printf '%s' "${SDD_HARNESS_CALLER_LC_ALL#set:}" > "$2" || return 3; return 0;;
+    esac
+  fi
+  [[ -n "${!1+set}" ]] || return 1
+  printf '%s' "${!1}" > "$2" || return 3
+}
