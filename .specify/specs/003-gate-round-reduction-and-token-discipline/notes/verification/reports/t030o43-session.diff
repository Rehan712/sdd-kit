+# is an empty result; a file grep cannot read is status 3. For grep the locale
+# pin is the repair (its decoding failure never shows in its status: it stops
+# matching at the byte and exits 0); this reads every other failure.
+vf_ids() (
+  local out rc
+  out="$(grep -oE -- "$1" "$2")"; rc=$?
