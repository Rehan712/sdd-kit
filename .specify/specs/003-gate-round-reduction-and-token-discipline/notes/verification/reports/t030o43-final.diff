+# fault_bin <dir> <program> <marker>... — write <dir>/<program>, which runs the
+# real one unless EVERY marker is found among its arguments (a marker matches
+# any argument containing it; a marker "=x" matches only an argument that is
+# exactly x), and then prints nothing and exits 2: a parser that died before
+# its output reached the reader, as macOS awk dies at a byte it cannot decode.
+# Put <dir> first on PATH for the one command under test (T030o43).
+fault_bin() {
+  local dir="$1" prog="$2" real m; shift 2
+  real="$(command -v "$prog")" || return 1
+  mkdir -p "$dir" || return 1
+  {
+    printf '#!/bin/bash\n'
