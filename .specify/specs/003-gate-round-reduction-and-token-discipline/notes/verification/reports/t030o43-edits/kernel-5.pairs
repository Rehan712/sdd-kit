      vf_quoted($0) { next }
      /^## / { stage=substr($0,4); sub(/[[:space:]]+$/, "", stage) }
@@NEW
    awk "$_VF_AWK_TEXT"'
      vf_quoted($0) { next }
      /^## / { stage=substr($0,4); sub(/[[:space:]]+$/, "", stage) }
@@END
@@OLD
# read as absent. Under C a byte >= 0x80 is also in no character class, so a
# record written with a non-ASCII space or letter where the grammar wants ASCII
# does not match it; each parser that decides with it refuses such a line, or,
# where it decides what must be covered, keeps more (T030o43 review). The
@@NEW
# read as absent. Under C a byte >= 0x80 is also in no character class, so
# every parser of author text reads non-ASCII Unicode whitespace through the
# one step of _VF_AWK_WS above, and a non-ASCII letter where a grammar wants an
# ASCII one fails that grammar and is refused by it (T030o43 reviews 1, 2). The
@@END
@@OLD
# quote; otherwise an inline ` #` comment and trailing blanks dropped), and fail
# with status 3 when the parse fails, so no parse failure reads as a passing
# result (T030o43).
vf_fm_value() { # <file> <key> -> the value, or nothing when the key is absent
  [[ -f "$1" ]] || return 0
  awk -v key="$2" '# vf_fm_value
    NR == 1 { if ($0 != "---") exit; next }
    /^---[[:space:]]*$/ { exit }
    index($0, key ":") == 1 {
      v = substr($0, length(key) + 2); sub(/^[[:space:]]+/, "", v)
      q = substr(v, 1, 1)
      if (q == "\"" || q == "\047") { v = substr(v, 2); sub(q ".*$", "", v) }
      else { sub(/[[:space:]]+#.*$/, "", v); sub(/[[:space:]]+$/, "", v) }
      print v; exit
    }
  ' "$1" || { printf 'error: %s: frontmatter could not be read for %s\n' "$1" "$2" >&2; return 3; }
}
vf_fm_count() { # <file> <key> -> how many frontmatter lines set the key
  [[ -f "$1" ]] || { echo 0; return 0; }
  awk -v name="$2" '# vf_fm_count
    NR == 1 { if ($0 != "---") exit; next }
    /^---[[:space:]]*$/ { exit }
    index($0, name ":") == 1 { n++ }
    END { print n + 0 }
  ' "$1" || { printf 'error: %s: frontmatter could not be counted for %s\n' "$1" "$2" >&2; return 3; }
}
@@NEW
# quote; otherwise an inline ` #` comment and trailing blanks dropped), with
# whitespace read through _VF_AWK_WS, and fail with status 3 when the parse
# fails, so no parse failure reads as a passing result (T030o43). A value is
# taken from the line as written and trimmed at its ends only: a worktree or
# branch it names is compared with the real one.
vf_fm_value() { # <file> <key> -> the value, or nothing when the key is absent
  [[ -f "$1" ]] || return 0
  awk -v key="$2" "$_VF_AWK_TEXT_UNFENCED"'# vf_fm_value
    NR == 1 { if ($0 != "---") exit; next }
    /^---[[:space:]]*$/ { exit }
    index($0, key ":") == 1 {
      v = vf_wstrim(substr(vf_original, length(key) + 2))
      q = substr(v, 1, 1)
      if (q == "\"" || q == "\047") { v = substr(v, 2); sub(q ".*$", "", v) }
      else { sub(/([[:space:]]|\302[\205\240]|\341\232\200|\342\200[\200-\212\250\251\257]|\342\201\237|\343\200\200)+#.*$/, "", v); v = vf_wstrim(v) }
      print v; exit
    }
  ' "$1" || { printf 'error: %s: frontmatter could not be read for %s\n' "$1" "$2" >&2; return 3; }
}
vf_fm_count() { # <file> <key> -> how many frontmatter lines set the key
  [[ -f "$1" ]] || { echo 0; return 0; }
  awk -v name="$2" "$_VF_AWK_TEXT_UNFENCED"'# vf_fm_count
    NR == 1 { if ($0 != "---") exit; next }
    /^---[[:space:]]*$/ { exit }
    index($0, name ":") == 1 { n++ }
    END { print n + 0 }
  ' "$1" || { printf 'error: %s: frontmatter could not be counted for %s\n' "$1" "$2" >&2; return 3; }
}
# vf_contract <spec.md> -> "1" for the versioned contract, nothing for a
# legacy spec. Routed by the KEY, as vf_bindings and vf_project_config route
# it: no key is legacy, one key whose value is 1 is current, and anything
# else -- an empty value, another value, a second key, a frontmatter that
# cannot be read -- is refused by name with status 3, never read as the
# legacy path (T030o43 review 2, R2-F6).
vf_contract() {
  local count value
  count="$(vf_fm_count "$1" verification_contract)" || return 3
  case "$count" in
    0) return 0;;
    1) value="$(vf_fm_value "$1" verification_contract)" || return 3
       [[ "$value" == 1 ]] && { echo 1; return 0; }
       printf 'unsupported verification contract: %s\n' "${value:-<empty>}" >&2; return 3;;
    *) printf 'unsupported verification contract: declared %s times\n' "$count" >&2; return 3;;
  esac
}
@@END
@@OLD
