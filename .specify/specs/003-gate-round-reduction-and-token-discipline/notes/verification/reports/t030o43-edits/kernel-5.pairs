      # value comes from the line as written, trimmed at its ends, and its
      # syntax is judged on the line read through the whitespace step.
      id!="" && /\*Verify:\*/ { set_field("Verify",after_written(vf_original,"Verify")); verify_read=after($0,"Verify"); next }
@@END
@@OLD
    # Every line that carries a manifest record's marker must parse as that
    # record, by the same field grammar a canonical finding obeys. The grammar
    # is ASCII, and under the harness pin a byte >= 0x80 is in no character
    # class, so a heading or field line written with a non-ASCII space no
    # longer matched it -- and was skipped in silence, which dropped the
    # finding, its strictest tier and its Class (T030o43 review F1).
    awk "$_VF_AWK_FENCE"'
      function bad(why) {printf "manifest line %d: %s: %s\n", FNR, why, $0 > "/dev/stderr"; failed=1}
      function flushm() {
        if(id!="" && cls=="") bad("finding " id " has no readable Class")
        if(id!="" && cls!="") print id ":" cls ":" sev
        id=""; cls=""; sev=""
      }
      vf_quoted($0) {next}
      /^#+ Finding [A-Z][A-Z0-9]*-[0-9]+[[:space:]]*$/ {flushm(); id=$NF; next}
      /^#+[^A-Za-z]*Finding([^A-Za-z]|$)/ {flushm(); bad("a Finding heading this grammar cannot read"); next}
      id != "" && /^-[[:space:]]+\*\*Class:\*\*/ {
        cls=$0; sub(/^.*\*\*Class:\*\*[[:space:]]*/, "", cls)
        gsub(/[[:space:]]/, "", cls)
        if (cls !~ /^[a-z][a-z0-9]*(-[a-z0-9]+)*$/) {bad("a Class this grammar cannot read"); cls="-"}
        next
      }
      id != "" && /^-[[:space:]]+\*\*Severity:\*\*/ {
        sev=$0; sub(/^.*\*\*Severity:\*\*[[:space:]]*/, "", sev)
        gsub(/[[:space:]]/, "", sev)
        if (sev !~ /^(data-loss|wrong-result|regression|crash|minor|degraded)$/) bad("a Severity this grammar cannot read")
        next
      }
      id != "" && /\*\*(Class|Severity):\*\*/ {bad("a Class or Severity line this grammar cannot read")}
      END {flushm(); if (failed) exit 3}
@@NEW
    # The pass reads by the canonical finding's own field grammar, keyed on
    # the lines that carry a record rather than on a heading it might not see
    # (T030o43 reviews 1 and 2). A heading is an ATX heading (up to three
    # spaces, a run of `#`, then a space, a tab or the end); every heading
    # closes the finding before it, and one whose first word is `Finding` in
    # any case and whose second is a finding ID opens one, a title allowed
    # after. A field is a line whose first word, after indentation, a list
    # marker and emphasis, is Class or Severity in any case with a colon inside
    # or outside the emphasis. It must be written `- **Class:**` or
    # `- **Severity:**` at any indentation, as the canonical parser reads it,
    # sit inside a finding, appear once in it, and carry a value of its
    # grammar. Any other line is prose, even one that mentions a field. A
    # finding with no Class, a field outside a finding, a second field, a
    # field or ID the grammar cannot read and quoting left open at the end are
    # each refused by name, so no spelling loses a finding: its fields fall
    # outside it, or into the one above, and both refuse. A byte-order mark on
    # the first line is not part of it.
    awk "$_VF_AWK_TEXT"'
      function bad(why) {printf "manifest line %d: %s: %s\n", FNR, why, vf_original > "/dev/stderr"; failed=1}
      function flushm() {
        if(id!="" && cls=="") bad("finding " id " has no readable Class")
        if(id!="" && cls!="") print id ":" cls ":" sev
        id=""; cls=""; sev=""; classes=0; severities=0
      }
      function value(s) {sub(/^.*\*\*[^*]+:\*\*[ ]*/, "", s); gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s}
      function fieldname(s,   t, w) {
        t=s; sub(/^[[:space:]]+/, "", t)
        if (t ~ /^[-*+][[:space:]]/) sub(/^[-*+][[:space:]]+/, "", t)
        sub(/^[*_]+/, "", t)
        if (!match(t, /^[A-Za-z]+/)) return ""
        w=tolower(substr(t, 1, RLENGTH)); t=substr(t, RLENGTH + 1); sub(/^[*_]+/, "", t)
        return (substr(t, 1, 1) == ":") ? w : ""
      }
      FNR == 1 {sub(/^\357\273\277/, "")}
      vf_quoted($0) {next}
      /^ ? ? ?#+([ \t]|$)/ {
        flushm(); heading=$0; sub(/^ +/, "", heading); split(heading, word, /[[:space:]]+/)
        if (tolower(word[2]) == "finding" && word[3] ~ /^[A-Za-z][A-Za-z0-9]*-[0-9]/) {
          if (word[3] ~ /^[A-Z][A-Z0-9]*-[0-9]+$/) id=word[3]
          else bad("a Finding heading whose ID this grammar cannot read")
        }
        next
      }
      {
        field=fieldname($0)
        if (field != "class" && field != "severity") next
        if (id == "") {bad("a " field " line outside any Finding"); next}
        if (field == "class") {
          if (classes++) {bad("a second Class line in finding " id); next}
          if ($0 !~ /^[ ]*-[[:space:]]+\*\*Class:\*\*/) {bad("a Class line this grammar cannot read"); cls="-"; next}
          cls=value($0)
          if (cls !~ /^[a-z][a-z0-9]*(-[a-z0-9]+)*$/) {bad("a Class this grammar cannot read"); cls="-"}
          next
        }
        if (severities++) {bad("a second Severity line in finding " id); next}
        if ($0 !~ /^[ ]*-[[:space:]]+\*\*Severity:\*\*/) {bad("a Severity line this grammar cannot read"); next}
        sev=value($0)
        if (sev !~ /^(data-loss|wrong-result|regression|crash|minor|degraded)$/) {bad("a Severity this grammar cannot read"); sev=""}
      }
      END {
        flushm()
        if (fenced) bad("a code fence is left open")
        if (commented) bad("an HTML comment is left open")
        if (rawkind) bad("a raw HTML block is left open")
        if (failed) exit 3
      }
@@END
@@OLD
  VF_REPORT_FILE="$file" awk -v gate="$gate" -v priorids="$priorids" "$_VF_AWK_FENCE"'
@@NEW
  VF_REPORT_FILE="$file" awk -v gate="$gate" -v priorids="$priorids" "$_VF_AWK_TEXT"'
@@END
@@OLD
    function value(s) {sub(/^.*\*\*[^*]+:\*\*[ ]*/, "", s); return clean(s)}
    # Blank is what a reader sees as blank. A section body is author text in
    # any script, so a line of only Unicode White_Space characters (their
    # UTF-8 encodings, which under the harness pin are in no class) is as empty
    # as a line of ASCII blanks; any other byte is content (T030o43 review).
    function vf_blank(s) {
      gsub(/[ \t\r\f\013]|\302[\205\240]|\341\232\200|\342\200[\200-\212\250\251\257]|\342\201\237|\343\200\200/, "", s)
      return s == ""
    }
@@NEW
    function value(s) {sub(/^.*\*\*[^*]+:\*\*[ ]*/, "", s); return clean(s)}
@@END
@@OLD
    cursec!="" && !vf_blank($0) && $0 !~ /^#+[ ]/ {secbody[n SUBSEP cursec]=1}
@@NEW
    cursec!="" && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#+[ ]/ {secbody[n SUBSEP cursec]=1}
@@END
@@OLD
      # The identity keeps more, never less: the section starts at the first
      # line that begins "## Decisions log", whatever follows on that line,
      # so a heading carrying a byte the grammar cannot read can no longer
      # take the whole log out of the input identity (T030o43 review).
      awk '/^## Decisions log/ && !seen {on=1; seen=1; print; next} /^## / {on=0} on {print}' "$2" > "$3";;
@@NEW
      # The identity keeps more, never less, and never less than the
      # authorization scanner reads (T030o43 review 2, R2-F1): a hashed
      # section starts at EVERY line that begins "## Decisions log" once its
      # whitespace is read, quoted or not, whatever follows on it, and ends
      # only at a "## " line the shared fence tracker does not quote. So no
      # earlier, archived, duplicate or fenced heading, and no heading quoted
      # inside the log, can take the lines the scanner reads out of the
      # identity. The lines are recognized as read and hashed as written.
      awk "$_VF_AWK_TEXT"'
        { quoted = vf_quoted($0) }
        /^## Decisions log/ { on = 1; print vf_original; next }
        !quoted && /^## / { on = 0 }
        on { print vf_original }
      ' "$2" > "$3";;
@@END
@@OLD
