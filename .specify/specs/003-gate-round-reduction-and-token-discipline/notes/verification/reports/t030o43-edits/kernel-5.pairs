    function flush() {if(id!="") {gsub(/[[:space:]]+/," ",text); sub(/ +$/, "",text); printf "%s%c%s%c",id,0,text,0}; id=""}
@@NEW
  awk "$_VF_AWK_TEXT_UNFENCED"'
    function flush() {if(id!="") {gsub(/[[:space:]]+/," ",text); sub(/ +$/, "",text); printf "%s%c%s%c",id,0,text,0}; id=""}
@@END
@@OLD
