@@OLD
# _VF_AWK_FENCE — the ONE fence tracker every parser shares. Quoted content is
@@NEW
# _VF_AWK_WS — the ONE reading of whitespace every parser of author text
# shares (T030o43, review 2). The harness parses under LC_ALL=C, where a byte
# >= 0x80 is in no character class, so a non-ASCII Unicode space stopped
# reading as the whitespace a UTF-8 locale had read it as: a field whose
# separator was a U+00A0 no longer matched, a value of only U+00A0 read as
# present, a name ran on across one. Repairing each site in turn kept finding
# the next, so every such parser takes one step before any rule of its own:
# vf_ws maps the UTF-8 encoding of each non-ASCII White_Space character
# (U+0085, U+00A0, U+1680, U+2000-U+200A, U+2028, U+2029, U+202F, U+205F and
# U+3000) to one VT byte. VT is in [[:space:]], so every class-based trim,
# separator and emptiness test reads the character as whitespace, as a UTF-8
# locale read U+00A0. VT is neither a space, a tab nor a default field
# separator, so every literal grammar -- CommonMark indentation, fences and
# block quotes, the canonical field line's single space, a `; ` separator --
# reads the line exactly as every locale read it before the pin, and the
# fence tracker below reaches the same state on the mapped line as on the
# line as written, which is what vf_report_block reads. ASCII whitespace is
# left alone. vf_original keeps the line as written: a value the harness
# passes on (the Verify command it runs, a frontmatter path it compares) and
# a line it hashes are taken from it, and vf_wstrim trims the same
# whitespace from their ends only.
_VF_AWK_WS='
function vf_ws(s) {
  gsub(/\302[\205\240]|\341\232\200|\342\200[\200-\212\250\251\257]|\342\201\237|\343\200\200/, "\013", s)
  return s
}
function vf_wstrim(s) {
  sub(/^([[:space:]]|\302[\205\240]|\341\232\200|\342\200[\200-\212\250\251\257]|\342\201\237|\343\200\200)+/, "", s)
  sub(/([[:space:]]|\302[\205\240]|\341\232\200|\342\200[\200-\212\250\251\257]|\342\201\237|\343\200\200)+$/, "", s)
  return s
}
'
# The step itself: the first rule of every parser of author text.
_VF_AWK_WSLINE='
{ vf_original = $0; $0 = vf_ws($0) }
'

# _VF_AWK_FENCE — the ONE fence tracker every parser shares. Quoted content is
@@END
@@OLD
  return vf_comment(s)
}
'

# vf_config <stack-file> <tasks-file-or-empty> <new-output-dir>
@@NEW
  return vf_comment(s)
}
'
# The preludes of a parser of author text: the whitespace reading, then the
# fence tracker when the parser suppresses quoted content, then the step.
# vf_report_block alone takes the fence tracker without the step, because its
# output is a sealed digest of the report as written.
_VF_AWK_TEXT="$_VF_AWK_WS$_VF_AWK_FENCE$_VF_AWK_WSLINE"
_VF_AWK_TEXT_UNFENCED="$_VF_AWK_WS$_VF_AWK_WSLINE"

# vf_config <stack-file> <tasks-file-or-empty> <new-output-dir>
@@END
@@OLD
