    function clean_cell(s) { s=trim(s); gsub(SUBSEP, "|", s); return s }
@@NEW
      "$_VF_AWK_TEXT"'
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    function clean_cell(s) { s=trim(s); gsub(SUBSEP, "|", s); return s }
@@END
