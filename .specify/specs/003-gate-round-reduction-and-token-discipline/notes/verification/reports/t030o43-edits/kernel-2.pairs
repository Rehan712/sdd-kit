@@NEW
  # A MET-002 line that could not be computed is a failed tally, never a
  # silently missing line at exit 0.
  LC_ALL=C awk -F '\t' '
    $1!="unclassified" {total[$1]++; if($3=="new" || $3=="reopened") {if(seen[$1]++) recur[$1]++}}
    END {for(c in total) printf "class=%s findings=%d recurrences=%d\n",c,total[c],recur[c]+0}
  ' "$tmp/classes" > "$tmp/class-lines" || { echo 'tally: the class table could not be computed' >&2; return 3; }
  LC_ALL=C sort "$tmp/class-lines" || { echo 'tally: the class table could not be sorted' >&2; return 3; }
  awk -F '\t' '{ids[$1 SUBSEP $2]=1; observations++; if($3=="reopened") reopened++}
    END {for(k in ids) distinct++; printf "finding-observations=%d distinct-finding-ids=%d reopened=%d\n", observations,distinct,reopened}' "$tmp/classes" ||
    { echo 'tally: the finding observations could not be counted' >&2; return 3; }
@@END
