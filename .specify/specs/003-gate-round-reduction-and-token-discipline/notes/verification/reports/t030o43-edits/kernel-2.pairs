@@OLD
  errors="$(awk -F "$us" '$1=="D" && $2=="error" {n++} END{print n+0}' "$records")"
  warnings="$(awk -F "$us" '$1=="D" && $2=="warning" {n++} END{print n+0}' "$records")"
@@NEW
  # An empty count is not zero errors: a failed count used to publish a catalog
  # that carried errors.
  if ! errors="$(awk -F "$us" '$1=="D" && $2=="error" {n++} END{print n+0}' "$records")" ||
     ! warnings="$(awk -F "$us" '$1=="D" && $2=="warning" {n++} END{print n+0}' "$records")"; then
    printf 'error: vf_bindings could not count its diagnostics\n' >&2
    rm -f "$records" "$maps" "$inventory"; rmdir "$tmpdir" 2>/dev/null || true
    return 1
  fi
@@END
@@OLD
  LC_ALL=C awk -F '\t' '
