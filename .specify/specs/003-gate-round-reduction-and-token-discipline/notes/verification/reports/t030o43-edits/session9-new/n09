      # The maps hold the plan and inventory values as written; the step
      # maps every input line, so their fields are split from vf_original.
      FNR==NR {
        split(vf_original, mf, FS)
        if (mf[1]=="F") { family_n++; family_name[family_n]=mf[2]; family_kind[family_n]=mf[3]; family_criteria[family_n]=mf[4]; family_loc[family_n]=mf[5] }
        else if (mf[1]=="I") { def_type[mf[2]]=mf[3]; if (!def_seen[mf[2]]++) def_ids[++def_n]=mf[2] }
        else if (mf[1]=="D") { def_family[mf[2] SUBSEP mf[4]]=1 }
        else if (mf[1]=="T") { task_order[mf[2]]=mf[3]; task_stage_by_id[mf[2]]=mf[4] }
        next
      }
