@@OLD
# _VF_AWK_LABEL — how both readers of finding records decide that a line
# carries a record (O-018). vf_label <line> <labels> returns the label the
# line carries when the first word of its rendered text is one of <labels>
# (a space-separated lower-case list) in any case, and the line is an
# emphasized label (the emphasis closes right after the word, or the
# emphasized span ends in a colon inside or right after it) or the word is not
# continued by a letter, digit or hyphen; otherwise "". The rendered text is
# taken from CommonMark rather than from spellings a review reported: inline
# raw HTML renders as nothing (comments, open and closing tags, processing
# instructions and declarations, CommonMark 6.6), a numeric character
# reference renders as its character (2.5), and the first word is the one
# after any run of characters that are not letters or digits (indentation,
# heading markers, any list marker, emphasis, backslash escapes), ordered-list
# numbers and task checkboxes. vf_finding_heading <line> is true when the text
# of an ATX heading is the word Finding in any case, not continued by a letter
# or digit, followed, after anything that is not a letter or digit, by a
# finding ID.
_VF_AWK_LABEL='
function vf_label_hex(h,   i, n) {
  n = 0; h = tolower(h)
  for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
  return n
}
function vf_label(s, labels,   t, w, emph, lead, span, rest, i, n) {
  while ((i = index(s, "<!--")) > 0) {
    n = index(substr(s, i + 4), "-->")
    s = n ? substr(s, 1, i - 1) substr(s, i + n + 6) : substr(s, 1, i - 1)
  }
  gsub(/<\/?[A-Za-z][A-Za-z0-9-]*[^>]*>|<[?!][^>]*>/, "", s)
  while (match(s, /&#[0-9]+;|&#[xX][0-9A-Fa-f]+;/)) {
    t = substr(s, RSTART + 2, RLENGTH - 3)
    n = (t ~ /^[xX]/) ? vf_label_hex(substr(t, 2)) : t + 0
    s = substr(s, 1, RSTART - 1) ((n > 32 && n < 127) ? sprintf("%c", n) : "\001") substr(s, RSTART + RLENGTH)
  }
  t = s; lead = ""
  while (t ~ /^([^A-Za-z0-9]|[0-9]+[.)]|\[[ xX]\])/) {
    if (match(t, /^([0-9]+[.)]|\[[ xX]\])/)) {lead = lead substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)}
    else {lead = lead substr(t, 1, 1); t = substr(t, 2)}
  }
  emph = (lead ~ /[*_]$/)
  if (!match(t, /^[A-Za-z]+/)) return ""
  w = tolower(substr(t, 1, RLENGTH)); if (!index(" " labels " ", " " w " ")) return ""
  t = substr(t, RLENGTH + 1)
  if (emph && t ~ /^[*_]/) return w
  if (emph && t !~ /^[A-Za-z0-9-]/) {
    span = t; sub(/[*_].*$/, "", span)
    if (span ~ /:[[:space:]]*$/) return w
    rest = substr(t, length(span) + 1)
    if (rest ~ /^[*_]/) {sub(/^[*_]+/, "", rest); if (rest ~ /^:/) return w}
  }
  sub(/^[*_[:space:]]+/, "", t)
  return (t ~ /^[A-Za-z0-9-]/) ? "" : w
}
function vf_finding_heading(s,   t) {
  t = s; sub(/^ *#+/, "", t); sub(/^([[:space:]]|[\200-\377])+/, "", t)
  if (tolower(substr(t, 1, 7)) != "finding" || substr(t, 8, 1) ~ /[A-Za-z0-9]/) return 0
  t = substr(t, 8); sub(/^[^A-Za-z0-9]+/, "", t)
  return t ~ /^[A-Za-z][A-Za-z0-9]*-[0-9]/
}
'
@@NEW
# _VF_AWK_LABEL — how both readers of finding records decide that a line
# carries a record (O-018). vf_label <line> <labels> returns the label the
# line carries when the first word of its text is one of <labels> (a
# space-separated lower-case list) in any case, and the line is an emphasized
# label (the emphasis closes right after the word, or the emphasized span ends
# in a colon inside or right after it) or the word is not continued by a
# letter, digit or hyphen; otherwise "". The first word is the one after any
# run of characters that are not letters or digits (indentation, heading
# markers, any list marker, emphasis, backslash escapes, quotes, brackets),
# ordered-list numbers and task checkboxes. The line is read twice, and a
# label either reading yields is returned, so a reading that approximates what
# a renderer shows can only make a line refuse, never let a visible label pass
# (T030o44 review F1, F9, F11): as written, and as rendered. The rendered
# reading takes out inline raw HTML by CommonMark 0.31.2's own productions
# (6.6: an open tag with its attributes, a quoted value holding `>` included,
# a closing tag, a comment, which `<!-->` and `<!--->` complete, a processing
# instruction, a declaration, a CDATA section; one left open hides the rest
# of the line), takes out a link's destination and title, a reference link's
# label and an image whole (6.3, 6.4), renders a footnote reference as its
# number, a numeric character reference as its character and a named one as a
# character that is no letter or digit (2.5; no named reference renders as an
# ASCII letter or digit). vf_finding_heading <line> is true when the text of an
# ATX heading is the word Finding in any case, not continued by a letter or
# digit, followed, after anything that is not a letter or digit, by a finding
# ID. vf_record <line> names the record a line carries to either reader (a
# finding field line, a Class or Severity line, a Finding heading) or is "".
# vf_block_start <text> is true when a line, without its indentation, starts a
# block that ends a list item's paragraph: a list item with text (an ordered
# one only when numbered 1, the only number that may interrupt a paragraph),
# an ATX heading, a block quote, a code fence a renderer opens (a backtick
# fence's info string holds no backtick), a comment or a thematic break. Any
# other line may continue the paragraph, which is the deny side. vf_field_item
# <text> is true when a line, without its indentation, is a list item opened
# by a bold label that ends in a colon: a field line, or a note written as
# one, which is a line of its own, never more text in the item above it.
_VF_AWK_LABEL='
function vf_label_hex(h,   i, n) {
  n = 0; h = tolower(h)
  for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
  return n
}
function vf_label_word(t, labels,   w, emph, lead, span, rest) {
  lead = ""
  while (t ~ /^([^A-Za-z0-9]|[0-9]+[.)]|\[[ xX]\])/) {
    if (match(t, /^([0-9]+[.)]|\[[ xX]\])/)) {lead = lead substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)}
    else {lead = lead substr(t, 1, 1); t = substr(t, 2)}
  }
  emph = (lead ~ /[*_]$/)
  if (!match(t, /^[A-Za-z]+/)) return ""
  w = tolower(substr(t, 1, RLENGTH)); if (!index(" " labels " ", " " w " ")) return ""
  t = substr(t, RLENGTH + 1)
  if (emph && t ~ /^[*_]/) return w
  if (emph && t !~ /^[A-Za-z0-9-]/) {
    span = t; sub(/[*_].*$/, "", span)
    if (span ~ /:[[:space:]]*$/) return w
    rest = substr(t, length(span) + 1)
    if (rest ~ /^[*_]/) {sub(/^[*_]+/, "", rest); if (rest ~ /^:/) return w}
  }
  sub(/^[*_[:space:]]+/, "", t)
  return (t ~ /^[A-Za-z0-9-]/) ? "" : w
}
function vf_label_html(s,   out, rest, n) {
  if (vf_lbl_tag == "") {
    vf_lbl_q = sprintf("%c", 39)
    vf_lbl_tag = "^<[A-Za-z][A-Za-z0-9-]*([ \t]+[A-Za-z_:][A-Za-z0-9_.:-]*([ \t]*=[ \t]*([^ \t\"" vf_lbl_q "=<>" sprintf("%c", 96) "]+|" vf_lbl_q "[^" vf_lbl_q "]*" vf_lbl_q "|\"[^\"]*\"))?)*[ \t]*/?>"
  }
  out = ""
  while ((n = index(s, "<")) > 0) {
    out = out substr(s, 1, n - 1); rest = substr(s, n)
    if (substr(rest, 1, 4) == "<!--") {n = index(substr(rest, 3), "-->"); s = n ? substr(rest, n + 5) : ""; continue}
    if (substr(rest, 1, 9) == "<![CDATA[") {n = index(rest, "]]>"); s = n ? substr(rest, n + 3) : ""; continue}
    if (substr(rest, 1, 2) == "<?") {n = index(substr(rest, 3), "?>"); s = n ? substr(rest, n + 4) : ""; continue}
    if (rest ~ /^<![A-Za-z]/) {n = index(rest, ">"); s = n ? substr(rest, n + 1) : ""; continue}
    if (match(rest, vf_lbl_tag) || match(rest, /^<\/[A-Za-z][A-Za-z0-9-]*[ \t]*>/)) {s = substr(rest, RLENGTH + 1); continue}
    out = out "<"; s = substr(rest, 2)
  }
  return out s
}
function vf_label_dest(s, j,   n, c, depth, q) {
  n = length(s); j++
  while (j <= n && substr(s, j, 1) ~ /[ \t]/) j++
  if (substr(s, j, 1) == "<") {
    while (j <= n && substr(s, j, 1) != ">") {if (substr(s, j, 1) == "\\") j++; j++}
    if (j > n) return 0
    j++
  } else {
    depth = 0
    while (j <= n) {
      c = substr(s, j, 1)
      if (c == "\\") {j += 2; continue}
      if (c ~ /[ \t]/) break
      if (c == "(") depth++
      else if (c == ")") {if (!depth) break; depth--}
      j++
    }
  }
  while (j <= n && substr(s, j, 1) ~ /[ \t]/) j++
  c = substr(s, j, 1)
  if (c == "\"" || c == vf_lbl_q || c == "(") {
    q = (c == "(") ? ")" : c; j++
    while (j <= n && substr(s, j, 1) != q) {if (substr(s, j, 1) == "\\") j++; j++}
    if (j > n) return 0
    j++
    while (j <= n && substr(s, j, 1) ~ /[ \t]/) j++
  }
  return (substr(s, j, 1) == ")") ? j + 1 : 0
}
function vf_label_links(s,   out, i, j, k, m) {
  out = ""
  while (match(s, /!?\[[^]]*\]/)) {
    i = RSTART; j = RSTART + RLENGTH; m = 0
    if (substr(s, j, 1) == "(") m = vf_label_dest(s, j)
    else if (substr(s, j, 1) == "[" && (k = index(substr(s, j + 1), "]"))) m = j + k + 1
    if (m) {out = out substr(s, 1, i - 1) (substr(s, i, 1) == "!" ? "" : substr(s, i, j - i)); s = substr(s, m)}
    else {out = out substr(s, 1, j - 1); s = substr(s, j)}
  }
  return out s
}
function vf_label_render(s,   t, n) {
  s = vf_label_html(s)
  gsub(/\[\^[^]]*\]/, "\001", s)
  s = vf_label_links(s)
  while (match(s, /&#[0-9]+;|&#[xX][0-9A-Fa-f]+;/)) {
    t = substr(s, RSTART + 2, RLENGTH - 3)
    n = (t ~ /^[xX]/) ? vf_label_hex(substr(t, 2)) : t + 0
    s = substr(s, 1, RSTART - 1) ((n > 32 && n < 127) ? sprintf("%c", n) : "\001") substr(s, RSTART + RLENGTH)
  }
  gsub(/&[A-Za-z][A-Za-z0-9]*;/, "\001", s)
  return s
}
function vf_label(s, labels,   w) {
  w = vf_label_word(vf_label_render(s), labels)
  return (w != "") ? w : vf_label_word(s, labels)
}
function vf_finding_heading(s,   t) {
  t = s; sub(/^ *#+/, "", t); sub(/^([[:space:]]|[\200-\377])+/, "", t)
  if (tolower(substr(t, 1, 7)) != "finding" || substr(t, 8, 1) ~ /[A-Za-z0-9]/) return 0
  t = substr(t, 8); sub(/^[^A-Za-z0-9]+/, "", t)
  return t ~ /^[A-Za-z][A-Za-z0-9]*-[0-9]/
}
function vf_record(s,   l) {
  l = vf_label(s, "class severity")
  if (l != "") return (l == "class") ? "Class line" : "Severity line"
  if (s ~ /^[ ]*-[[:space:]]+\*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/) return "finding field line"
  if (s ~ /^ ? ? ?#+([ \t]|$)/) return (vf_finding_heading(s) || s ~ /^### Finding /) ? "Finding heading" : ""
  if (s ~ /^([[:space:]]|[\200-\377])*#+([[:space:]]|[\200-\377])*[Ff][Ii][Nn][Dd][Ii][Nn][Gg]([^A-Za-z]|$)/) return "Finding heading"
  return ""
}
function vf_field_item(t) {
  return (t ~ /^[-+*][ \t]+\*\*[^*]+:\*\*/)
}
function vf_block_start(t,   b) {
  b = sprintf("%c", 96)
  if (t ~ /^[-+*][ \t]+[^ \t]/ || t ~ /^1[.)][ \t]+[^ \t]/) return 1
  if (t ~ /^(#|##|###|####|#####|######)([ \t]|$)/ || t ~ /^>/ || t ~ /^<!--/ || t ~ /^~~~/) return 1
  if (t ~ ("^" b b b "[^" b "]*$")) return 1
  return (t ~ /^(\*[ \t]*\*[ \t]*\*[* \t]*|-[ \t]*-[ \t]*-[- \t]*|_[ \t]*_[ \t]*_[_ \t]*)$/)
}
'
@@END
@@OLD
    # The pass reads by the canonical finding's own field grammar, keyed on
    # the lines that carry a record rather than on a heading it might not see
    # (T030o43 reviews 1 to 4), and what it cannot read it refuses by name,
    # never reads as prose (O-018). A heading is an ATX heading (up to three
    # spaces, a run of `#`, then a space, a tab or the end). One whose first
    # word is `Finding` in any case and whose second is a finding ID opens a
    # finding, a title allowed after; any other heading vf_finding_heading
    # reads as a Finding heading is refused. A finding is the section its
    # heading opens: a heading as shallow as that one closes it, and a deeper
    # heading is one of its lines, classified like any other (O-019). A line
    # not read as a heading whose text, after leading whitespace or invisible
    # characters, is a `#` run and the word Finding is refused by name, so a
    # finding's fields cannot fall into the one above it (R3-F3). A field is
    # decided by its label, read from the line's rendered text by vf_label
    # (R3-F2, R4-F2, O-018): Class or Severity. Inside a finding such a line
    # must be a dash, whitespace and `**Class:**` or `**Severity:**`, at any
    # indentation, appear once, and carry a value of its grammar, which is the
    # text after that label and nothing further (R3-F1); anything else -- a
    # heading, or a label behind inline HTML, included -- is refused by name.
    # Every finding needs one readable Class and one readable Severity, so a
    # tier the pass does not read (a quoted one included) is refused with its
    # finding, never dropped (O-018). Outside any finding that written
    # spelling is refused, and any other such line is prose only while
    # nothing since the last heading can hold a finding's record: a finding
    # ID on the heading or a line, or a heading whose second word is Finding
    # (R3-F5, R4-F1). Quoting left open at the end, and a manifest from which
    # no finding is read (R4-F4), are refused by name. A finding whose opening
    # line is no heading at all (a setext heading, raw HTML, a bold line, a
    # heading inside a list item) is recorded extent: its Class and Severity
    # lines are refused, inside another finding as second fields and outside
    # any once its ID is seen. A byte-order mark on the first line is not
    # part of it.
@@NEW
    # The pass reads by the canonical finding's own field grammar, keyed on
    # the lines that carry a record rather than on a heading it might not see
    # (T030o43 reviews 1 to 4), and what it cannot read it refuses by name,
    # never reads as prose (O-018). A heading is an ATX heading (up to three
    # spaces, a run of `#`, then a space, a tab or the end). One whose first
    # word is `Finding` in any case and whose second is a finding ID opens a
    # finding, a title allowed after; any other heading vf_finding_heading
    # reads as a Finding heading is refused. A finding is the section its
    # heading opens: a heading as shallow as that one closes it, and a deeper
    # heading is one of its lines, classified like any other (O-019). A line
    # not read as a heading whose text, after leading whitespace or invisible
    # characters, is a `#` run and the word Finding is refused by name, so a
    # finding's fields cannot fall into the one above it (R3-F3). A field is
    # decided by its label, read by vf_label from the line as written and as
    # rendered (R3-F2, R4-F2, O-018): Class or Severity. Inside a finding such
    # a line must be a dash, whitespace and `**Class:**` or `**Severity:**`, at
    # any indentation, appear once, and carry a value of its grammar, which is
    # the text after that label and nothing further (R3-F1); anything else --
    # a heading, or a label behind inline HTML, included -- is refused by name.
    # The list item a field line opens holds that line only: a line that would
    # continue its paragraph, or any further text inside the item other than a
    # nested field line (vf_field_item, read as its own line), is read by a
    # reader as part of the field and is refused by name (T030o44 review F10). Every finding needs one readable Class and one readable Severity,
    # so a tier the pass does not read is refused with its finding, never
    # dropped (O-018). The shared tracker skips quoted content, and as a line
    # reader without CommonMark's containers it can quote content a renderer
    # shows, so a quoted line that carries a record (vf_record) is refused by
    # name, never skipped (T030o44 review F4). Outside any finding that
    # written spelling is refused, and any other such line is prose only while
    # nothing since the last heading can hold a finding's record: a finding
    # ID on the heading or a line, or a heading whose second word is Finding
    # (R3-F5, R4-F1). Quoting left open at the end, and a manifest from which
    # no finding is read (R4-F4), are refused by name. A finding whose opening
    # line is no heading at all (a setext heading, raw HTML, a bold line, a
    # heading inside a list item) is recorded extent: its Class and Severity
    # lines are refused, inside another finding as second fields and outside
    # any once its ID is seen. A byte-order mark on the first line is not
    # part of it.
@@END
@@OLD
      FNR == 1 {sub(/^\357\273\277/, "")}
      vf_quoted($0) {next}
@@NEW
      FNR == 1 {sub(/^\357\273\277/, "")}
      itemfield != "" {
        if ($0 ~ /^[ \t]*$/) itemblank=1
        else {
          ii=match($0, /[^ ]/) - 1
          if (substr($0, ii + 1, 1) == "\t" || (ii >= itemind + 2 ? !vf_field_item(substr($0, ii + 1)) : !itemblank && !vf_block_start(substr($0, ii + 1))))
            bad("a " itemfield " field whose list item holds more than its line in finding " itemid)
          itemfield=""
        }
      }
      vf_quoted($0) {shape=vf_record($0); if (shape != "") bad("quoted content carries a " shape); next}
@@END
@@OLD
          cls=value($0, "Class")
@@NEW
          cls=value($0, "Class"); itemfield="Class"; itemind=match($0, /[^ ]/) - 1; itemblank=0; itemid=id
@@END
@@OLD
        sev=value($0, "Severity")
@@NEW
        sev=value($0, "Severity"); itemfield="Severity"; itemind=match($0, /[^ ]/) - 1; itemblank=0; itemid=id
@@END
@@OLD
    vf_quoted($0) {
      # Quoting does not exempt a line from the after-marker rule: a fenced,
      # commented or blockquoted preamble is still content the accumulator
      # would attribute to the sealed round above it.
      if (ended && $0 !~ /^[ ]*$/) err("content after the round completion marker")
      next
    }
@@NEW
    # A Class, Severity or Status field decides a binding, a tier or a count
    # by its value, and a reader reads the whole list item its line opens: a
    # line that would continue its paragraph, or any further text inside the
    # item other than a nested field line (vf_field_item, read as its own
    # line), is read there as part of the field, so that item holds the field
    # line only (T030o44 review F10). It is checked before quoting is, because
    # the tracker can quote a line a renderer continues the paragraph with.
    itemfield != "" {
      if ($0 ~ /^[ \t]*$/) itemblank=1
      else {
        ii=match($0, /[^ ]/) - 1
        if (substr($0, ii + 1, 1) == "\t" || (ii >= itemind + 2 ? !vf_field_item(substr($0, ii + 1)) : !itemblank && !vf_block_start(substr($0, ii + 1))))
          err("a " itemfield " field whose list item holds more than its line in finding " itemid)
        itemfield=""
      }
    }
    vf_quoted($0) {
      # Quoting does not exempt a line from the after-marker rule: a fenced,
      # commented or blockquoted preamble is still content the accumulator
      # would attribute to the sealed round above it.
      if (ended && $0 !~ /^[ ]*$/) err("content after the round completion marker")
      # The tracker is a line reader that does not track CommonMark containers, so what
      # it quotes can be content a renderer shows (T030o44 review F4): a
      # quoted line inside a canonical round that carries a record of a finding
      # is refused by name, never skipped.
      else if (style=="canonical" && active && (shape=vf_record($0)) != "") err("quoted content carries a " shape)
      next
    }
@@END
@@OLD
    # A field line outside any finding is a record the count never sees,
    # whatever line opened the finding to its author, and inside a finding a
    # line whose label vf_label reads as Class or Severity, and which is not
    # the line of that field, carries a Class or a tier this pass would not read.
    # Both are refused by name (O-018), as the manifest pass refuses them.
    style=="canonical" && !ended && !fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {err("a finding field outside any Finding"); next}
    style=="canonical" && fid && !/^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      lbl=vf_label($0, "class severity")
      if (lbl != "") err("a " (lbl == "class" ? "Class" : "Severity") " line this grammar cannot read in finding " fid)
    }
    fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      # The key is the label of the field, not the spelling of the line, so an indented
      # second Severity is the same field (O-018).
      key=$0; sub(/:\*\*.*/,"",key); sub(/^[ ]*/,"",key)
      if(seenfindingfield[n SUBSEP fid SUBSEP key]++) err("duplicate finding field")
      v=value(vf_original)
@@NEW
    # A field line outside any finding is a record the count never sees,
    # whatever line opened the finding to its author, and inside a finding a
    # line whose label vf_label reads as Class or Severity, and which is not
    # the line of that field, carries a Class or a tier this pass would not read.
    # Both are refused by name (O-018), as the manifest pass refuses them, in a
    # canonical round of either gate, since the tally counts the findings of
    # both (T030o44 review F5). The second refuses prose too: any line inside a
    # finding whose first word, as written or as rendered, is Class or Severity
    # and is not continued by a letter, digit or hyphen (`class, not one
    # spelling of it`), so a report puts another word first (T030o44 review F2).
    style=="canonical" && !ended && !fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {err("a finding field outside any Finding"); next}
    style=="canonical" && fid && !/^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      lbl=vf_label($0, "class severity")
      if (lbl != "") err("a " (lbl == "class" ? "Class" : "Severity") " line this grammar cannot read in finding " fid)
    }
    fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      # The key is the label of the field, not the spelling of the line, so an
      # indented second Severity is the same field (O-018), in a round of either
      # style: an indented duplicate in a legacy round is refused too (T030o44
      # review F3).
      key=$0; sub(/:\*\*.*/,"",key); sub(/^[ ]*/,"",key)
      if(seenfindingfield[n SUBSEP fid SUBSEP key]++) err("duplicate finding field")
      v=value(vf_original)
      if (style=="canonical" && key ~ /^- \*\*(Class|Severity|Status)$/) {itemfield=substr(key, 5); itemind=match($0, /[^ ]/) - 1; itemblank=0; itemid=fid}
@@END
