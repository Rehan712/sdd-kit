@@OLD
# The preludes of a parser of author text: the whitespace reading, then the
# fence tracker when the parser suppresses quoted content, then the step.
# vf_report_block alone takes the fence tracker without the step, because its
# output is a sealed digest of the report as written.
_VF_AWK_TEXT="$_VF_AWK_WS$_VF_AWK_FENCE$_VF_AWK_WSLINE"
@@NEW
# _VF_AWK_LABEL — how both readers of finding records decide that a line
# carries a record (O-018). vf_label <line> <labels> returns the label the
# line carries when the first word of its rendered text is one of <labels>
# (a space-separated lower-case list) in any case, and the line is an
# emphasized label (the emphasis closes right after the word, or the
# emphasized span ends in a colon inside or right after it) or the word is not
# continued by a letter, digit or hyphen; otherwise "". The rendered text is
# taken from CommonMark rather than from spellings a review reported: inline
# raw HTML renders as nothing (comments, open and closing tags, processing
# instructions and declarations, CommonMark 6.6), a numeric character
# reference renders as its character (2.5), and the first word is the one
# after any run of characters that are not letters or digits (indentation,
# heading markers, any list marker, emphasis, backslash escapes), ordered-list
# numbers and task checkboxes. vf_finding_heading <line> is true when the text
# of an ATX heading is the word Finding in any case, not continued by a letter
# or digit, followed, after anything that is not a letter or digit, by a
# finding ID.
_VF_AWK_LABEL='
function vf_label_hex(h,   i, n) {
  n = 0; h = tolower(h)
  for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
  return n
}
function vf_label(s, labels,   t, w, emph, lead, span, rest, i, n) {
  while ((i = index(s, "<!--")) > 0) {
    n = index(substr(s, i + 4), "-->")
    s = n ? substr(s, 1, i - 1) substr(s, i + n + 6) : substr(s, 1, i - 1)
  }
  gsub(/<\/?[A-Za-z][A-Za-z0-9-]*[^>]*>|<[?!][^>]*>/, "", s)
  while (match(s, /&#[0-9]+;|&#[xX][0-9A-Fa-f]+;/)) {
    t = substr(s, RSTART + 2, RLENGTH - 3)
    n = (t ~ /^[xX]/) ? vf_label_hex(substr(t, 2)) : t + 0
    s = substr(s, 1, RSTART - 1) ((n > 32 && n < 127) ? sprintf("%c", n) : "\001") substr(s, RSTART + RLENGTH)
  }
  t = s; lead = ""
  while (t ~ /^([^A-Za-z0-9]|[0-9]+[.)]|\[[ xX]\])/) {
    if (match(t, /^([0-9]+[.)]|\[[ xX]\])/)) {lead = lead substr(t, 1, RLENGTH); t = substr(t, RLENGTH + 1)}
    else {lead = lead substr(t, 1, 1); t = substr(t, 2)}
  }
  emph = (lead ~ /[*_]$/)
  if (!match(t, /^[A-Za-z]+/)) return ""
  w = tolower(substr(t, 1, RLENGTH)); if (!index(" " labels " ", " " w " ")) return ""
  t = substr(t, RLENGTH + 1)
  if (emph && t ~ /^[*_]/) return w
  if (emph && t !~ /^[A-Za-z0-9-]/) {
    span = t; sub(/[*_].*$/, "", span)
    if (span ~ /:[[:space:]]*$/) return w
    rest = substr(t, length(span) + 1)
    if (rest ~ /^[*_]/) {sub(/^[*_]+/, "", rest); if (rest ~ /^:/) return w}
  }
  sub(/^[*_[:space:]]+/, "", t)
  return (t ~ /^[A-Za-z0-9-]/) ? "" : w
}
function vf_finding_heading(s,   t) {
  t = s; sub(/^ *#+/, "", t); sub(/^([[:space:]]|[\200-\377])+/, "", t)
  if (tolower(substr(t, 1, 7)) != "finding" || substr(t, 8, 1) ~ /[A-Za-z0-9]/) return 0
  t = substr(t, 8); sub(/^[^A-Za-z0-9]+/, "", t)
  return t ~ /^[A-Za-z][A-Za-z0-9]*-[0-9]/
}
'
# The preludes of a parser of author text: the whitespace reading, the label
# reading, then the fence tracker when the parser suppresses quoted content,
# then the step. vf_report_block alone takes the fence tracker without the
# step, because its output is a sealed digest of the report as written.
_VF_AWK_TEXT="$_VF_AWK_WS$_VF_AWK_LABEL$_VF_AWK_FENCE$_VF_AWK_WSLINE"
@@END
@@OLD
    # The pass records a finding only at the next Finding heading or at END,
    # so an awk that dies part-way loses the finding in progress and every one
    # after it -- the strictest tier and Class binding three guards read. Its
    # status used to be read by nobody (O-017), so it is read here.
    # The pass reads by the canonical finding's own field grammar, keyed on
    # the lines that carry a record rather than on a heading it might not see
    # (T030o43 reviews 1 to 4). A heading is an ATX heading (up to three
    # spaces, a run of `#`, then a space, a tab or the end); every heading
    # closes the finding before it, and one whose first word is `Finding` in
    # any case and whose second is a finding ID opens one, a title allowed
    # after. A line not read as a heading whose text, after leading
    # whitespace or invisible characters, is a `#` run and the word Finding
    # is refused by name, so a finding's fields cannot fall into the one
    # above it (R3-F3). A field is decided by its label (R3-F2, R4-F2): a line
    # whose first word, after any run of characters that are not letters or
    # digits (indentation, any list marker, emphasis), ordered-list numbers
    # and task checkboxes, is Class or Severity in any case, and which is an
    # emphasized label (the emphasis closes right after the word, or the
    # emphasized span ends in a colon inside or right after it) or is not
    # continued by a letter, digit or hyphen. Inside a finding such a line
    # must be a dash, whitespace and `**Class:**` or `**Severity:**`, at any
    # indentation, appear once, and carry a value of its grammar, which is the
    # text after that label and nothing further (R3-F1); anything else is
    # refused by name. Outside any finding that written spelling is refused,
    # and any other such line is prose only while nothing since the last
    # heading can hold a finding's record: a finding ID on the heading or a
    # line, a heading whose second word is Finding, or a heading deeper than
    # the Finding heading it follows, which the canonical grammar reads as
    # part of that finding (R3-F5, R4-F1). A finding with no Class, a field or
    # ID the grammar cannot read, quoting left open at the end, and a manifest
    # from which no finding is read (R4-F4) are each refused by name. A
    # finding whose opening line is no heading at all (a setext heading, raw
    # HTML, a bold line, a heading inside a list item) is recorded extent. A
    # byte-order mark on the first line is not part of it.
@@NEW
    # The pass records a finding only at the next Finding heading or at END,
    # so an awk that dies part-way loses the finding in progress and every one
    # after it -- the strictest tier and Class binding three guards read. Its
    # status used to be read by nobody (O-017), so it is read here.
    # The pass reads by the canonical finding's own field grammar, keyed on
    # the lines that carry a record rather than on a heading it might not see
    # (T030o43 reviews 1 to 4), and what it cannot read it refuses by name,
    # never reads as prose (O-018). A heading is an ATX heading (up to three
    # spaces, a run of `#`, then a space, a tab or the end). One whose first
    # word is `Finding` in any case and whose second is a finding ID opens a
    # finding, a title allowed after; any other heading vf_finding_heading
    # reads as a Finding heading is refused. A finding is the section its
    # heading opens: a heading as shallow as that one closes it, and a deeper
    # heading is one of its lines, classified like any other (O-019). A line
    # not read as a heading whose text, after leading whitespace or invisible
    # characters, is a `#` run and the word Finding is refused by name, so a
    # finding's fields cannot fall into the one above it (R3-F3). A field is
    # decided by its label, read from the line's rendered text by vf_label
    # (R3-F2, R4-F2, O-018): Class or Severity. Inside a finding such a line
    # must be a dash, whitespace and `**Class:**` or `**Severity:**`, at any
    # indentation, appear once, and carry a value of its grammar, which is the
    # text after that label and nothing further (R3-F1); anything else -- a
    # heading, or a label behind inline HTML, included -- is refused by name.
    # Every finding needs one readable Class and one readable Severity, so a
    # tier the pass does not read (a quoted one included) is refused with its
    # finding, never dropped (O-018). Outside any finding that written
    # spelling is refused, and any other such line is prose only while
    # nothing since the last heading can hold a finding's record: a finding
    # ID on the heading or a line, or a heading whose second word is Finding
    # (R3-F5, R4-F1). Quoting left open at the end, and a manifest from which
    # no finding is read (R4-F4), are refused by name. A finding whose opening
    # line is no heading at all (a setext heading, raw HTML, a bold line, a
    # heading inside a list item) is recorded extent: its Class and Severity
    # lines are refused, inside another finding as second fields and outside
    # any once its ID is seen. A byte-order mark on the first line is not
    # part of it.
@@END
@@OLD
      function flushm() {
        if(id!="" && cls=="") bad("finding " id " has no readable Class")
        if(id!="" && cls!="") {print id ":" cls ":" sev; recorded++}
        id=""; cls=""; sev=""; classes=0; severities=0
      }
@@NEW
      function flushm() {
        if(id!="" && cls=="") bad("finding " id " has no readable Class")
        if(id!="" && !severities) bad("finding " id " has no readable Severity")
        if(id!="" && cls!="") {print id ":" cls ":" sev; recorded++}
        id=""; cls=""; sev=""; classes=0; severities=0
      }
@@END
@@OLD
      function fieldname(s,   t, w, emph, lead, span, rest) {
        t=s; lead=""
        while (t ~ /^([^A-Za-z0-9]|[0-9]+[.)]|\[[ xX]\])/) {
          if (match(t, /^([0-9]+[.)]|\[[ xX]\])/)) {lead=lead substr(t, 1, RLENGTH); t=substr(t, RLENGTH + 1)}
          else {lead=lead substr(t, 1, 1); t=substr(t, 2)}
        }
        emph=(lead ~ /[*_]$/)
        if (!match(t, /^[A-Za-z]+/)) return ""
        w=tolower(substr(t, 1, RLENGTH)); if (w != "class" && w != "severity") return ""
        t=substr(t, RLENGTH + 1)
        if (emph && t ~ /^[*_]/) return w
        if (emph && t !~ /^[A-Za-z0-9-]/) {
          span=t; sub(/[*_].*$/, "", span)
          if (span ~ /:[[:space:]]*$/) return w
          rest=substr(t, length(span) + 1)
          if (rest ~ /^[*_]/) {sub(/^[*_]+/, "", rest); if (rest ~ /^:/) return w}
        }
        sub(/^[*_[:space:]]+/, "", t)
        return (t ~ /^[A-Za-z0-9-]/) ? "" : w
      }
@@NEW
      function fieldname(s) {return vf_label(s, "class severity")}
@@END
@@OLD
      /^ ? ? ?#+([ \t]|$)/ {
        flushm(); heading=$0; sub(/^ +/, "", heading); split(heading, word, /[[:space:]]+/)
        hl=match(heading, /[^#]/); hl=(hl ? hl - 1 : length(heading))
        if (tolower(word[2]) == "finding" && word[3] ~ /^[A-Za-z][A-Za-z0-9]*-[0-9]/) {
          if (word[3] ~ /^[A-Z][A-Z0-9]*-[0-9]+$/) {id=word[3]; flevel=hl}
          else bad("a Finding heading whose ID this grammar cannot read")
        } else if (flevel && hl <= flevel) flevel=0
        idseen=(heading ~ /[A-Za-z][A-Za-z0-9]*-[0-9]/) || tolower(word[2]) == "finding" || (flevel && hl > flevel)
        next
      }
      /^([[:space:]]|[\200-\377])*#+([[:space:]]|[\200-\377])*[Ff][Ii][Nn][Dd][Ii][Nn][Gg]([^A-Za-z]|$)/ {
        flushm(); idseen=1; bad("a Finding heading this grammar cannot read"); next
      }
@@NEW
      /^ ? ? ?#+([ \t]|$)/ {
        heading=$0; sub(/^ +/, "", heading); split(heading, word, /[[:space:]]+/)
        hl=match(heading, /[^#]/); hl=(hl ? hl - 1 : length(heading))
        if (tolower(word[2]) == "finding" && word[3] ~ /^[A-Za-z][A-Za-z0-9]*-[0-9]/) {
          flushm(); idseen=1
          if (word[3] ~ /^[A-Z][A-Z0-9]*-[0-9]+$/) {id=word[3]; flevel=hl}
          else bad("a Finding heading whose ID this grammar cannot read")
          next
        }
        if (vf_finding_heading($0)) {flushm(); flevel=0; idseen=1; bad("a Finding heading this grammar cannot read"); next}
        if (id == "" || hl <= flevel) {
          flushm(); flevel=0
          idseen=(heading ~ /[A-Za-z][A-Za-z0-9]*-[0-9]/) || tolower(word[2]) == "finding"
          next
        }
        subheading=1
      }
      !subheading && /^([[:space:]]|[\200-\377])*#+([[:space:]]|[\200-\377])*[Ff][Ii][Nn][Dd][Ii][Nn][Gg]([^A-Za-z]|$)/ {
        flushm(); idseen=1; bad("a Finding heading this grammar cannot read"); next
      }
@@END
@@OLD
        field=fieldname($0)
@@NEW
        subheading=0; field=fieldname($0)
@@END
@@OLD
    /^### Finding / {finding(); if(!active || ended) err("finding outside round"); vf_fields(vf_original, hw); fid=hw[3]; cursec=""; next}
    # Round, review and finding headings are consumed above, so what remains
    # here is a section heading. Level is not fixed by the templates.
    /^#+[ ]/ {
      heading=$0; sub(/^#+[ ]+/,"",heading); cursec=tolower(clean(heading))
      section[n SUBSEP cursec]=1
    }
@@NEW
    /^### Finding / {finding(); if(!active || ended) err("finding outside round"); vf_fields(vf_original, hw); fid=hw[3]; cursec=""; next}
    # Only `### Finding <ID>` opens a finding here, while a reader sees one in
    # any heading vf_finding_heading reads as a Finding heading: Finding in any
    # case and a finding ID, at any level, whatever separates them. Such a
    # heading is refused by name, never read as a section, and so is a line not
    # read as a heading that is a `#` run and the word Finding, as the manifest
    # pass refuses it (O-018).
    style=="canonical" && !ended && /^ ? ? ?#+([ \t]|$)/ && vf_finding_heading($0) {err("a Finding heading this grammar cannot read"); next}
    style=="canonical" && !ended && !/^ ? ? ?#+([ \t]|$)/ && /^([[:space:]]|[\200-\377])*#+([[:space:]]|[\200-\377])*[Ff][Ii][Nn][Dd][Ii][Nn][Gg]([^A-Za-z]|$)/ {err("a Finding heading this grammar cannot read"); next}
    # A finding is the section its heading opens: a heading as shallow as `###`
    # closes it, and a deeper one is one of its lines (O-018, the canonical half
    # of the O-019 rule), so a field line after a section heading is outside it.
    style=="canonical" && fid && /^ ? ? ?(#|##|###)([ \t]|$)/ {finding()}
    # Round, review and finding headings are consumed above, so what remains
    # here is a section heading. Level is not fixed by the templates.
    /^#+[ ]/ {
      heading=$0; sub(/^#+[ ]+/,"",heading); cursec=tolower(clean(heading))
      section[n SUBSEP cursec]=1
    }
@@END
@@OLD
    fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      key=$0; sub(/:\*\*.*/,"",key)
      if(seenfindingfield[n SUBSEP fid SUBSEP key]++) err("duplicate finding field")
@@NEW
    # A field line outside any finding is a record the count never sees,
    # whatever line opened the finding to its author, and inside a finding a
    # line whose label vf_label reads as Class or Severity, and which is not
    # the line of that field, carries a Class or a tier this pass would not read.
    # Both are refused by name (O-018), as the manifest pass refuses them.
    style=="canonical" && !ended && !fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {err("a finding field outside any Finding"); next}
    style=="canonical" && fid && !/^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      lbl=vf_label($0, "class severity")
      if (lbl != "") err("a " (lbl == "class" ? "Class" : "Severity") " line this grammar cannot read in finding " fid)
    }
    fid && /^[ ]*- \*\*(Class|Status|Prior|Severity|Where|Root cause|Scenario|Reproduced|Blocks|Wrong behavior|Class-wide fix):\*\*/ {
      # The key is the label of the field, not the spelling of the line, so an indented
      # second Severity is the same field (O-018).
      key=$0; sub(/:\*\*.*/,"",key); sub(/^[ ]*/,"",key)
      if(seenfindingfield[n SUBSEP fid SUBSEP key]++) err("duplicate finding field")
@@END
