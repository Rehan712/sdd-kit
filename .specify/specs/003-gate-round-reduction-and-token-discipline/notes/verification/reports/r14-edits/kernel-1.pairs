        if (field == "" && pl != "") {field=(pl == "Class line") ? "class" : "severity"; pfield=1}
        if (field != "class" && field != "severity") {if ($0 ~ /[A-Za-z][A-Za-z0-9]*-[0-9]/) idseen=1; next}
        strict=!pfield && ((field == "class") ? ($0 ~ /^[ ]*-[[:space:]]+\*\*Class:\*\*/) : ($0 ~ /^[ ]*-[[:space:]]+\*\*Severity:\*\*/))
@@END
@@OLD
