@@END
@@OLD
      flush(); n=substr($0, 10); active=1; style="canonical"; declared=date=verdict=utc=source=floor=cursec=suppressed=""; ended=counted=blockers=minors=downgraded=0; next
@@NEW
      flush(); n=substr($0, 10); active=1; style="canonical"; declared=date=verdict=utc=source=floor=cursec=suppressed=""; ended=counted=blockers=minors=downgraded=body=0; next
@@END
@@OLD
    /^# (Opponent review|Reality Check)/ {
      if (ended) {err("content after the round completion marker"); next}
      if (!active) {n=last+1; active=1; style="legacy"; declared=date=verdict=utc=source=floor=suppressed=""; ended=counted=blockers=minors=downgraded=0}
      else if (!declared && !utc) style="legacy"
      next
    }
@@NEW
    # The style of a round decides which rules judge its lines, so it is decided
    # before the round has a body (round 14, O-020). The round heading makes a
    # round canonical, a report title read before its Round and Timestamp lines
    # makes it legacy, and a Timestamp line makes it canonical; once the round
    # has a body -- any non-blank line but its heading, its title and its
    # identity fields -- a title that would make it legacy, or a Timestamp
    # line that would make it canonical, is refused by name. Otherwise the
    # lines before the switch were judged by the rules of one style while the
    # round was sealed by the other: a title and a late Timestamp skipped every
    # canonical rule of finding() and of the record readers, the count
    # included, while flush() judged the round canonical.
    /^# (Opponent review|Reality Check)/ {
      if (ended) {err("content after the round completion marker"); next}
      if (!active) {n=last+1; active=1; style="legacy"; declared=date=verdict=utc=source=floor=suppressed=""; ended=counted=blockers=minors=downgraded=body=0}
      else if (!declared && !utc) {if (style=="canonical" && body) err("a report title after the body of a canonical round"); style="legacy"}
      next
    }
@@END
@@OLD
      if(key=="**Timestamp") {utc=v; date=substr(v,1,10); style="canonical"}
@@NEW
      if(key=="**Timestamp") {if (style=="legacy" && body) err("a Timestamp line after the body of a round its title made legacy"); utc=v; date=substr(v,1,10); style="canonical"}
@@END
@@OLD
      if(key=="**Verdict") verdict=v
      next
    }
    /^<!-- gate-round-end:/ {
@@NEW
      if(key=="**Verdict") verdict=v
      next
    }
    active && $0 !~ /^[[:space:]]*$/ {body=1}
    /^<!-- gate-round-end:/ {
@@END
