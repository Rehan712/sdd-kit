      else if (style=="canonical" && active && (shape=vf_record($0)) != "" && (fid != "" || shape == "Finding heading")) err("quoted content carries a " shape)
      next
    }
@@NEW
      # quoted line that carries a record of it, or whose paragraph does
      # (round 14, O-018), is refused by name, never skipped. A quoted field
      # line outside any finding attaches to none.
      else if (style=="canonical" && active) {
        shape=vf_record($0); if (shape == "" && fid != "") shape=vf_para_label()
        if (shape != "" && (fid != "" || shape == "Finding heading")) err("quoted content carries a " shape)
      }
