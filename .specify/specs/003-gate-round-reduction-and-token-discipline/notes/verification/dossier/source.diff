+  verification_edit_fixture "$spec_dir/tasks.md" 's/REQ-002, AC-002, FM-001/REQ-002, FM-001/'
+  verification_edit_fixture "$spec_dir/tasks.md" 's/REQ-001, REQ-002, AC-001, AC-002/REQ-001, REQ-002, AC-001/'
